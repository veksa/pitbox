<?xml version="1.0" encoding="utf-8"?>
<!-- Debug source set only: the release variant of the library declares no components and carries no code but the
     empty package class (src/main). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

  <application>
    <!-- Applies the saved dev server before the app's own code runs. -->
    <provider
      android:name="dev.pitbox.connect.PitboxConnectProvider"
      android:authorities="${applicationId}.pitbox"
      android:exported="false"
      android:initOrder="1000" />

    <!-- pitbox.<applicationId>://connect?devserver=host:port — what `pitbox qr` encodes. -->
    <activity
      android:name="dev.pitbox.connect.PitboxConnectActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pitbox.${applicationId}" android:host="connect" />
      </intent-filter>
    </activity>

    <!-- `pitbox push`: hands an emulated FCM message to the app's own FirebaseMessagingService. Reached only by
         explicit component from adb (the DUMP permission is the shell's, never an installed app's). -->
    <receiver
      android:name="dev.pitbox.connect.PitboxPushReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP"
      tools:ignore="ExportedReceiver" />
  </application>
</manifest>
