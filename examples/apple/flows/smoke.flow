# The example app end to end: input (a secure field too), the stand on the Mac's network, scrolling, a deep link.
tool reset
open!
wait id=title 30
fill id=name "Ada"
press id=greet
expect text="Hello, Ada"
# A secure field holds the whole text even when the keyboard's layout has no keys for its letters.
fill id=password "Secret-pass-1"
expect text="Secret-pass-1"
press id=fetch
wait text~="hello from the stand" 10
tool hits contains "1"
scroll down until text="Row 40"
expect id=row_40
goto detail id=42
wait text="Detail 42" 10
press id=back
expect id=content_list
