<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The same APK on a phone and a watch. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <!-- pitbox's relay reaches the daemon at the emulator's host alias. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="pitbox relay" android:theme="@android:style/Theme.DeviceDefault">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <activity android:name=".RelayActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Answers a ping with a pong, also when nothing of the app runs. -->
        <service android:name=".PingService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/ping" />
            </intent-filter>
        </service>
    </application>
</manifest>
