# The smoke flow on iOS, where there is no back key: the detail screen closes when it is pressed.
tool reset
open!
wait id=title 90
fill id=name "Ada"
press id=greet
expect text="Hello, Ada"
press id=fetch
wait text~="hello from the stand" 10
tool hits contains "1"
scroll down until text="Row 40"
goto detail id=42
wait text="Detail 42" 10
press id=detail-screen
expect id=content-list
