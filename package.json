{
  "name": "@veksa/pitbox",
  "version": "0.0.0",
  "description": "Run, drive and debug apps on emulators, simulators and devices from one MCP server — fast and token-lean",
  "license": "MIT",
  "author": "Aleksandr Khizhnyi <mendler88@gmail.com>",
  "type": "module",
  "bin": "./dist/bin.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runners/android/pitbox-runner.apk",
    "runners/apple/Host",
    "runners/apple/Runner",
    "runners/apple/PitboxRunner.xcodeproj/project.pbxproj",
    "runners/apple/PitboxRunner.xcodeproj/xcshareddata",
    "android/build.gradle",
    "android/src",
    "react-native.config.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-all": "yarn compile && yarn test",
    "build-runner": "node scripts/build-runner.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:apple": "node scripts/e2e-apple.mjs"
  },
  "keywords": [
    "mcp",
    "agent",
    "android",
    "ios",
    "tvos",
    "visionos",
    "android-tv",
    "android-xr",
    "emulator",
    "simulator",
    "e2e",
    "automation",
    "web",
    "playwright"
  ],
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
