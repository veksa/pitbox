{
  "name": "@veksa/pitbox",
  "version": "0.3.1",
  "description": "Run, drive and debug apps on emulators, simulators and devices from one MCP server — fast and token-lean",
  "license": "MIT",
  "author": "Aleksandr Khizhnyi <mendler88@gmail.com>",
  "homepage": "https://github.com/veksa/pitbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veksa/pitbox.git"
  },
  "bugs": "https://github.com/veksa/pitbox/issues",
  "type": "module",
  "bin": "./dist/bin.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./push": {
      "types": "./dist/push/client.d.ts",
      "default": "./dist/push/client.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "runners/android/pitbox-runner.apk",
    "runners/apple/Fold",
    "runners/apple/Host",
    "runners/apple/Runner",
    "runners/apple/Mac",
    "runners/apple/PitboxRunner.xcodeproj/project.pbxproj",
    "runners/apple/PitboxRunner.xcodeproj/xcshareddata",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src",
    "react-native.config.js",
    "PitboxConnect.podspec",
    "connect/apple/Sources"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-all": "yarn compile && yarn test",
    "build-runner": "node scripts/build-runner.mjs",
    "check-connect": "node scripts/check-connect.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:apple": "node scripts/e2e-apple.mjs",
    "e2e:mac": "node scripts/e2e-mac.mjs",
    "prepack": "yarn build",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "mcp",
    "agent",
    "android",
    "ios",
    "tvos",
    "visionos",
    "macos",
    "android-tv",
    "android-xr",
    "emulator",
    "simulator",
    "e2e",
    "automation",
    "web",
    "playwright"
  ],
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
